AUC1 <- as.numeric(auc(roc(as.factor(Dat$Z.cont), result$prob.Z.Cont)))
AUC2 <- as.numeric(auc(roc(as.factor(Dat$Z.bin), result$prob.Z.Bin)))
print(AUC1); print(AUC2)
}
